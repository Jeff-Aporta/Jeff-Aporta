{
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "iswc": {
    "host": "https://jeff-aporta.github.io/Jeff-Aporta/"
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "sloppy-imports"
  ],
  "imports": {
    "@browserbasehq/stagehand": "npm:@browserbasehq/stagehand@4.1.0",
    "@types/node": "npm:@types/node@^22.20.5",
    "esbuild": "npm:esbuild@0.28.1",
    "jsdom": "npm:jsdom@29.1.1",
    "zod": "npm:zod@4.4.3",
    "sass": "npm:sass@^1.105.0",
    "@std/http/file-server": "jsr:@std/http@1/file-server",
    "@iswc/component-schemas": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/previews/_kit/schemas/component.schemas.ts",
    "@iswc/loader-schemas": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/schemas/loader.schemas.ts",
    "@iswc/build/": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/",
    "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/hash.js": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/hash.ts",
    "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/asset-url.js": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/asset-url.ts",
    "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/asset-url.schemas.js": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/cdn/build/asset-url.schemas.ts",
    "@iswc/testing/": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/vendor-distributions/shared/testing/",
    "@iswc/tools/": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/vendor-distributions/shared/tools/"
  },
  "tasks": {
    "build:scss": "deno run -A scripts/build/build-scss.mjs",
    "icons": "deno run -A --reload=https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/ assets/dl.js",
    "build": "deno task icons ; deno task build:scss && deno run -A src/utils/build.ts && deno task build:meta",
    "dev": "deno run -A src/utils/build.ts --watch",
    "serve": "deno run -A jsr:@std/http@1/file-server -p 4200 --host 127.0.0.1",
    "check": "deno check src/js/ view/ scripts/build/build-meta.ts",
    "pin": "deno run -A https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/a1df39adb9e421de874dd624901b72daa9e25e5c/src/vendor-distributions/shared/tools/pin-update.mjs --repo=Jeff-Aporta/is-webcomponents --raices=index.html,assets/dl.js,src,view,deno.json",
    "test": "deno task build && deno run -A scripts/gate/test-health.mjs",
    "test:health": "deno run -A scripts/gate/test-health.mjs",
    "test:e2e": "deno run -A scripts/gate/e2e/run.ts",
    "test:all": "deno run -A scripts/gate/run-test-all.mjs",
    "test:all:halt": "deno run -A scripts/gate/run-test-all.mjs --halt",
    "sync:entregable": "deno run -A scripts/gate/sync-to-entregable.mjs",
    "build:meta": "deno run -A scripts/build/build-meta.ts"
  },
  "exclude": [
    "dist/",
    "node_modules/",
    ".tmp/",
    ".tmp-scss/"
  ]
}
