            {
              "control": "select",
              "prop": "props:tam",
              "label": "tam",
              "default": "lg",
              "options": [
                "md",
                "lg"
              ]
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout tone=\"info\"><strong slot=\"title\">Cuándo usarlo</strong>Controles de <ja-post> y regreso al blog.</iswc-callout>"
