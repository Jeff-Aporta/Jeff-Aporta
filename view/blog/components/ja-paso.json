      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stage\"><ja-paso id=\"demo\"></ja-paso></div>",
          "target": "#demo",
          "props": {
            "paso": {
              "titulo": "Rayos hacia cada esquina",
              "icono": "mdi:white-balance-sunny",
              "narracion": "Desde la luz lanzamos un rayo hacia cada esquina de cada pared y nos quedamos con el primer choque: ahí termina lo que se ve.",
              "bloques": [
                { "tipo": "nota", "tono": "info", "titulo": "Por qué a las esquinas", "md": "Entre dos esquinas la frontera de la luz es una **línea recta**: basta con conocer sus extremos." }
              ],
              "demo": null
            },
            "indice": 2,
            "total": 10,
            "creditos": "",
            "audio": "assets/blog/luz-y-sombra-2d/voz/02.mp3",
            "sonando": false
          },
          "controls": [
            {
              "control": "number",
              "prop": "props:indice",
              "label": "indice",
              "default": 2
            },
            {
              "control": "number",
              "prop": "props:total",
              "label": "total",
              "default": 10
            },
            {
              "control": "text",
              "prop": "props:creditos",
              "label": "creditos (solo en el último paso)",
              "default": ""
            },
            {
              "control": "boolean",
              "prop": "props:sonando",
              "label": "sonando",
              "default": false
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout tone=\"info\"><strong slot=\"title\">Cuándo usarlo</strong>Dentro de <ja-post>, que le pasa el paso de post.json.</iswc-callout>"
        }
      ]
    }
  ]
